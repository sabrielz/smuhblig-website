{
	frankenphp
	admin off
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

:8000 {
	root * /app/public
	encode zstd br gzip

	request_body {
		max_size 25MB
	}

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
	}

	php_server

	log {
		output stderr
		level WARN
	}
}
